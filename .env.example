# Copy to .env.local and fill in. Never commit real secrets.

# Public canonical URL (used for sitemap, canonical links, Open Graph)
NEXT_PUBLIC_SITE_URL=https://keepsmilingvisuals.example

# --- Inquiry delivery (Resend transactional email) ---
# Without RESEND_API_KEY the inquiry endpoint answers 503 "not_configured"
# and the form shows the mailto fallback. It never fakes success.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=keepsmilingvisuals@gmail.com
# Must be an address on a domain verified in Resend
INQUIRY_FROM_EMAIL=

# Development only: log inquiries to the server console instead of emailing.
# Ignored when NODE_ENV=production.
INQUIRY_DEV_LOG=0

# --- Rate limiting (optional, recommended in production) ---
# Without these, an in-memory per-instance limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optional, cookieless endpoint that accepts JSON beacons) ---
# Leave empty to disable analytics entirely. When set, events are only sent
# after the visitor accepts analytics in the consent banner.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
